
# BTL (Binary Translation Layer) Specification for ML Primitives
# This file defines the binary encoding format for ML operations

# Token Format:
# [BTL_TOKEN_START][ML_MODEL][ALGORITHM_TYPE][PARAMS][...][BTL_TOKEN_END]

# Token Definitions
BTL_TOKEN_START = 0xFF
BTL_TOKEN_END = 0xFE

# ML Model Types
ML_MODEL_LINEAR_REG = 0x10
ML_MODEL_DECISION_TREE = 0x11
ML_MODEL_SVM = 0x12
ML_MODEL_KMEANS = 0x13

# Operation Types
ML_OP_TRAIN = 0x01
ML_OP_PREDICT = 0x02
ML_OP_EVALUATE = 0x03

# Linear Regression Tokens
# Format: [START][LINEAR_REG][OP][N_FEATURES][LEARNING_RATE][...][END]
LINEAR_REG_PREDICT_TOKEN = [0xFF, 0x10, 0x02]
LINEAR_REG_TRAIN_TOKEN = [0xFF, 0x10, 0x01]

# Decision Tree Tokens
# Format: [START][TREE][OP][MAX_DEPTH][MIN_SAMPLES][...][END]
TREE_PREDICT_TOKEN = [0xFF, 0x11, 0x02]
TREE_TRAIN_TOKEN = [0xFF, 0x11, 0x01]
TREE_SPLIT_TOKEN = [0xFF, 0x11, 0x04]  # Internal split operation

# SVM Tokens
# Format: [START][SVM][OP][KERNEL_TYPE][C][GAMMA][...][END]
SVM_PREDICT_TOKEN = [0xFF, 0x12, 0x02]
SVM_TRAIN_TOKEN = [0xFF, 0x12, 0x01]
SVM_KERNEL_LINEAR = [0xFF, 0x12, 0x10]
SVM_KERNEL_RBF = [0xFF, 0x12, 0x11]

# K-means Tokens
# Format: [START][KMEANS][OP][N_CLUSTERS][N_FEATURES][...][END]
KMEANS_PREDICT_TOKEN = [0xFF, 0x13, 0x02]
KMEANS_TRAIN_TOKEN = [0xFF, 0x13, 0x01]
KMEANS_ASSIGN_TOKEN = [0xFF, 0x13, 0x04]  # Cluster assignment
KMEANS_UPDATE_TOKEN = [0xFF, 0x13, 0x05]  # Centroid update

# Parameter Encoding
# Integers: 4 bytes (little-endian)
# Floats: 8 bytes (IEEE 754 double precision)
# Arrays: [LENGTH (4 bytes)][DATA...]

# Example Token Sequences:

# Linear Regression Prediction:
# [0xFF][0x10][0x02][n_features (4 bytes)][feature_1 (8 bytes)]...[feature_n (8 bytes)][0xFE]

# Decision Tree Training:
# [0xFF][0x11][0x01][max_depth (4 bytes)][n_samples (4 bytes)][n_features (4 bytes)]
# [X_data (n_samples * n_features * 8 bytes)][y_data (n_samples * 8 bytes)][0xFE]

# SVM with RBF Kernel Prediction:
# [0xFF][0x12][0x02][0x11][gamma (8 bytes)][n_features (4 bytes)]
# [feature_1 (8 bytes)]...[feature_n (8 bytes)][0xFE]

# K-means Clustering:
# [0xFF][0x13][0x01][n_clusters (4 bytes)][n_samples (4 bytes)][n_features (4 bytes)]
# [X_data (n_samples * n_features * 8 bytes)][0xFE]

# Q-learning Tokens
# Format: [START][QLEARNING][OP][N_STATES][N_ACTIONS][PARAMS][...][END]
ML_MODEL_QLEARNING = 0x14
QLEARNING_SELECT_ACTION_TOKEN = [0xFF, 0x14, 0x02]
QLEARNING_UPDATE_TOKEN = [0xFF, 0x14, 0x01]
QLEARNING_GET_Q_VALUE_TOKEN = [0xFF, 0x14, 0x03]
QLEARNING_TRAIN_EPISODE_TOKEN = [0xFF, 0x14, 0x04]

# Q-learning Parameter Encoding:
# [START][QLEARNING][OP][n_states (4 bytes)][n_actions (4 bytes)]
# [alpha (8 bytes)][gamma (8 bytes)][epsilon (8 bytes)]
# [state (4 bytes)][action (4 bytes)][reward (8 bytes)]
# [next_state (4 bytes)][done (1 byte)][END]

# Q-learning Action Selection:
# [0xFF][0x14][0x02][state (4 bytes)][0xFE]
# Returns: action (4 bytes)

# Q-learning Update:
# [0xFF][0x14][0x01][state (4 bytes)][action (4 bytes)][reward (8 bytes)]
# [next_state (4 bytes)][done (1 byte)][0xFE]

# Q-learning Get Q-value:
# [0xFF][0x14][0x03][state (4 bytes)][action (4 bytes)][0xFE]
# Returns: q_value (8 bytes)

# Integration with BTL ISA:
# These tokens can be embedded in BTL instruction streams and will be
# recognized by the BTL decoder to invoke ML-specific execution paths.

# Optimization Hints:
# - Use BTL_PEEPHOLE for common ML operation patterns
# - BTL_SCHEDULER can optimize ML operation ordering
# - BTL_REGALLOC handles temporary storage for ML computations
# - Q-learning Q-table lookups can be optimized with caching
